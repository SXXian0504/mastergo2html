MCP_PORT=12322

# Choose exactly one LLM backend.
# 1) OpenAI-compatible API Key backend
LLM_BACKEND=openai-compatible
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://token.cvte.com/v1
OPENAI_MODEL=gpt-5.5
OPENAI_WIRE_API=responses
LLM_CONNECT_TIMEOUT_MS=120000

# Per-model protocol override example:
# OPENAI_MODEL=deepseek-v4-pro
# OPENAI_WIRE_API_DEEPSEEK_V4_PRO=chat-completions

# 2) Codex SDK backend: uses the local Codex CLI login, so this project does
# not need OPENAI_API_KEY. Run `codex login` before starting the service.
# LLM_BACKEND=codex-sdk
# CODEX_PATH=
# CODEX_MODEL=
# CODEX_REASONING_EFFORT=high
# CODEX_SANDBOX_MODE=read-only
# CODEX_REUSE_THREAD=true

# Multi-page scheduling defaults
PAGE_WORKER_CONCURRENCY=2
GLOBAL_MODEL_CONCURRENCY=2
PAGE_TRANSIENT_RETRY_LIMIT=2
PAGE_RETRY_BASE_DELAY_MS=5000
GLOBAL_ERROR_PAUSE_THRESHOLD=2
QUALITY_GATE_PAGE_COUNT=2
